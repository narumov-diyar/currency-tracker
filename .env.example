# Скопировать в .env и подставить свои значения. Файл .env в репозиторий не попадает.
# Сервер читает .env при запуске сам. Переменные окружения, если они заданы,
# имеют приоритет над файлом — в контейнере настройки приходят снаружи.

# Строка подключения к PostgreSQL
DATABASE_URL=postgres://tracker:tracker@localhost:5432/tracker?sslmode=disable

# Адрес, который слушает API
API_ADDR=:8080

# Сколько секунд ждать завершения активных запросов при остановке
API_SHUTDOWN_TIMEOUT=10

# Через сколько секунд повторять проход свёртки истории: он строит
# укрупнённые свечи за закрывшиеся периоды и удаляет истёкшие.
ROLLUP_INTERVAL=60

# Секрет для подписи сессионных токенов, не короче 32 символов.
# Сгенерировать: openssl rand -base64 48
AUTH_SECRET=замените-на-случайную-строку-не-короче-32-символов

# Настройки Compose. DATABASE_URL выше используется только при запуске вне Docker.
# В контейнерах адрес базы задаёт compose.yaml; пароль передаётся отдельно.
# Пароль существующей базы не меняется от редактирования этого значения.
POSTGRES_PASSWORD=tracker
# Порт API на компьютере; внутри контейнера сервер всегда слушает :8080.
API_PORT=8080
# Порт веб-клиента на компьютере
WEB_PORT=3000
# --- Сборщик данных (collector) ---
# DATABASE_URL общий с сервером. Остальные значения необязательны,
# ниже указаны значения по умолчанию.

# Время ожидания одного HTTP-запроса к источнику, секунды
COLLECTOR_HTTP_TIMEOUT=10

# Попыток на запрос при временных ошибках (паузы 1 с, 2 с, 4 с)
COLLECTOR_RETRY_ATTEMPTS=4

# Неуспешных циклов подряд до размыкания предохранителя источника
COLLECTOR_BREAKER_THRESHOLD=3

# Сколько секунд предохранитель держит источник отключённым
COLLECTOR_BREAKER_OPEN_INTERVAL=300

# Через сколько секунд повторять неуспешный суточный опрос фиатных курсов
COLLECTOR_FIAT_RETRY_INTERVAL=600

# Размер пула соединений с базой
COLLECTOR_DB_POOL_SIZE=5

# Уровень журнала: DEBUG, INFO, WARNING, ERROR
COLLECTOR_LOG_LEVEL=INFO
