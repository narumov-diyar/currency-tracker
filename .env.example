# Скопировать в .env и подставить свои значения. Файл .env в репозиторий не попадает.
# Сервер читает .env при запуске сам. Переменные окружения, если они заданы,
# имеют приоритет над файлом — в контейнере настройки приходят снаружи.

# Строка подключения к PostgreSQL
DATABASE_URL=postgres://tracker:tracker@localhost:5432/tracker?sslmode=disable

# Адрес, который слушает API
API_ADDR=:8080

# Сколько секунд ждать завершения активных запросов при остановке
API_SHUTDOWN_TIMEOUT=10

# Через сколько секунд повторять проход свёртки истории: он строит
# укрупнённые свечи за закрывшиеся периоды и удаляет истёкшие.
ROLLUP_INTERVAL=60

# Секрет для подписи сессионных токенов, не короче 32 символов.
# Сгенерировать: openssl rand -base64 48
AUTH_SECRET=замените-на-случайную-строку-не-короче-32-символов
